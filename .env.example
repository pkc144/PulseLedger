NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://pulseledger:pulseledger@localhost:5432/pulseledger
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_CLAIM_LEASE_SECONDS=300
# Required. Sent as the x-admin-api-key header on /v1/admin/* routes. Generate with, e.g.,
# `openssl rand -hex 32`. At least 16 characters.
ADMIN_API_KEY=replace-with-a-random-secret-of-at-least-16-characters
REQUEST_BODY_LIMIT_BYTES=16384
CONNECTION_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=30000
