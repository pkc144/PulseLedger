# Firebase web app config (Firebase console → Project settings → Your apps → Web).
# These are public client identifiers, not secrets. Copy to .env.local and fill in.
# Leave VITE_FIREBASE_API_KEY empty to hide Google / email sign-in and use API keys only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional. Where the landing page's Documentation links point (defaults to GitHub docs/).
VITE_DOCS_BASE_URL=
